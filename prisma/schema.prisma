generator client {
  provider      = "prisma-client-js"
  log           = ["query"]
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Alert {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  alertTime    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  repeatDay    Int?
  repeatWeekly Boolean  @default(false)
}

model Game {
  id    Int    @id @default(autoincrement())
  name  String @unique
  sales Sale[]
}

model Ingredient {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  price       Int
  quantity    Float?
  typeUnity   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  Origin      String              @default("Desconocido")

  providerId  Int?                // 👈 nuevo campo
  provider    Provider?           @relation(fields: [providerId], references: [id])

  products    ProductIngredient[]

  @@index([providerId])
}

model Product {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?             @db.Text
  price       Float
  quantity    Float?
  typeUnity   String?
  barcode     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    String              @default("Desconocida")
  rappi_price Float?
  ingredients ProductIngredient[]
  sales       SaleProduct[]
}

model ProductIngredient {
  productId    Int
  ingredientId Int
  quantity     Int
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@id([productId, ingredientId])
  @@index([ingredientId], map: "ProductIngredient_ingredientId_fkey")
}

model Provider {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  accountNumber String
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ingredients   Ingredient[]   // 👈 relación inversa
  movements ProviderMovement[]
}

model Sale {
  id                 Int           @id @default(autoincrement())
  totalAmount        Float
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  status             String
  table              String
  generalObservation String?
  gameId             Int?
  orderType          String        @default("En mesa")
  user               String        @default("Administrador")
  game               Game?         @relation(fields: [gameId], references: [id])
  products           SaleProduct[]

  // 👇 Nuevo (F5): tipo de pago y monto en efectivo cuando es efectivo/mixto.
  //    El monto de transferencia se infiere en la UI por diferencia y no se
  //    duplica en un campo aparte.
  paymentType        String?       // "efectivo" | "transferencia" | "mixto"
  cashAmount         Float?

  // 👇 Nuevo (F6): % de descuento aplicado a toda la comanda al momento del
  //    pago. totalAmount ya queda guardado con el descuento aplicado; este
  //    campo es solo para trazabilidad/reportes de promociones.
  discountPercent    Float?        @default(0)

  @@index([gameId], map: "Sale_gameId_fkey")
}

model SaleProduct {
  id          String                @id @default(cuid())
  saleId      Int
  productId   Int
  quantity    Float
  observation String?
  product     Product               @relation(fields: [productId], references: [id])
  sale        Sale                  @relation(fields: [saleId], references: [id])
  additions   SaleProductAddition[]

  @@index([productId], map: "SaleProduct_productId_fkey")
  @@index([saleId], map: "SaleProduct_saleId_fkey")
}

model SaleProductAddition {
  id            Int         @id @default(autoincrement())
  saleProductId String
  name          String
  price         Float
  additionId    Int?
  saleProduct   SaleProduct @relation(fields: [saleProductId], references: [id])

  @@index([saleProductId])
}

model Subscription {
  id             Int       @id @default(autoincrement())
  endpoint       String    @unique
  expirationTime DateTime?
  keys           String    @db.LongText
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Int?
}

model Utils {
  id         Int      @id @default(autoincrement())
  ipv4       String
  created_at DateTime @updatedAt
}

model ProviderMovement {
  id          Int       @id @default(autoincrement())
  provider    Provider  @relation(fields: [providerId], references: [id])
  providerId  Int

  type        MovementType
  amount      Float
  description String?
  imageUrl    String?

  createdAt   DateTime  @default(now())
}

model Business {
  id             Int      @id @default(autoincrement())
  type           String
  name           String
  nit            String?
  address        String?
  phone          String?
  taxPercentage  Float    @default(0)
  primaryColor   String   @default("#000000")
  secondaryColor String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

}


enum MovementType {
  INVOICE   // Factura (entra deuda → saldo sube)
  PAYMENT   // Pago (sale dinero → saldo baja)
}